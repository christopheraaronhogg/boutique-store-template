{
  "name": "boutique-store",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "ci": "npm run check && vitest run && vite build",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "seed": "node scripts/seed.mjs",
    "deploy": "npm run check && vitest run && npm run build && npm run db:migrate:remote && wrangler deploy",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.1",
    "@cloudflare/workers-types": "5.20261109.1",
    "@fontsource/allura": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/italiana": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/parisienne": "^5.3.0",
    "@sveltejs/adapter-cloudflare": "7.2.10",
    "@sveltejs/kit": "2.70.4",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "vite": "8.1.7",
    "vitest": "4.1.12",
    "wrangler": "4.159.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.1.12"
  },
  "cloudflare": {
    "bindings": {
      "OWNER_PASSWORD": {
        "description": "The store password. The owner types it to sign in at **/admin** and to connect Muse. Use 10 or more characters."
      },
      "STORE_KEY": {
        "description": "Optional backup key for assistants that only take an API key. Leave the example or paste 48 random letters and numbers; 32 characters or more."
      }
    }
  }
}
